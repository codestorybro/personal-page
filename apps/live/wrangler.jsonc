{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codestorybro-live",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/presenter", "/presenter/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "LiveSession" },
      { "name": "CATALOG", "class_name": "Catalog" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveSession", "Catalog"] },
  ],
  "r2_buckets": [
    { "binding": "PDFS", "bucket_name": "codestorybro-live-private-pdfs" },
  ],
  "vars": {
    "APP_ORIGIN": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "PRESENTER_EMAIL": "",
  },
  "env": {
    "local": {
      "workers_dev": false,
      "vars": {
        "DEV_AUTH": "local-only",
        "APP_ORIGIN": "http://127.0.0.1:8787",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "PRESENTER_EMAIL": "",
      },
      "durable_objects": {
        "bindings": [
          { "name": "SESSIONS", "class_name": "LiveSession" },
          { "name": "CATALOG", "class_name": "Catalog" },
        ],
      },
      "r2_buckets": [
        {
          "binding": "PDFS",
          "bucket_name": "codestorybro-live-private-pdfs-local",
        },
      ],
    },
  },
}
